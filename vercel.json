{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "redirects": [
    { "source": "/digital-atelier/:path*", "destination": "/invitations.html", "permanent": false },
    { "source": "/classy-white.html", "destination": "/invitations.html", "permanent": false },
    { "source": "/invitation-builder-dev.html", "destination": "/invitations.html", "permanent": false }
  ]
}
